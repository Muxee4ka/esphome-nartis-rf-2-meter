# Скопируйте в secrets.yaml рядом с конфигом (в ESPHome Device Builder — кнопка SECRETS)
# и заполните. secrets.yaml в git не коммитится.

wifi_ssid: "MyWiFi"
wifi_password: "wifi-password"

# 12 цифр серийного номера с шильдика счётчика. Обязательно в кавычках,
# иначе YAML прочитает номер как число и потеряет ведущий ноль.
nartis_serial: "023200000000"

# 32 случайных байта в base64. Сгенерировать: openssl rand -base64 32
# (или взять из мастера новой платы в ESPHome Device Builder).
nartis_api_key: "REPLACE_WITH_BASE64_32_BYTES="

nartis_ota_password: "ota-password"
nartis_fallback_ap: "fallback-ap-password"
