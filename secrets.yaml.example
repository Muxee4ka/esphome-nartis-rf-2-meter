# Copy to secrets.yaml (git-ignored) and fill in.
wifi_ssid: "your-wifi"
wifi_password: "your-wifi-password"
fallback_ap_password: "at-least-8-chars"
# 32 random bytes, base64:  python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
api_encryption_key: "REPLACE_ME"
ota_password: "REPLACE_ME"
# Meter serial, exactly 12 digits from the nameplate, quoted.
nartis_serial: "000000000000"
